{
  "manifest_version": 3,
  "name": "YouTube Ad Annihilator",
  "version": "1.0",
  "description": "Instantly skips YouTube ads.",
  "permissions": [],
  "content_scripts": [
    {
      "matches": [
  "*://*.youtube.com/*",
  "*://m.youtube.com/*"
],
     "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}